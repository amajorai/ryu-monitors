{
  "id": "@ryu/monitors",
  "name": "Monitors",
  "version": "1.0.0",
  "category": "Developer Tools",
  "description": "Website monitors: price, stock, keyword, content, and uptime watches with cross-device notification fan-out.",
  "icon": "radar-01",
  "iconDither": { "from": 357, "to": 323, "direction": "up" },
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "monitors-companion",
      "name": "Monitors",
      "kind": "companion",
      "config": {
        "label": "Monitors",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "sidecars": [
    {
      "name": "ryu-monitors",
      "process": {
        "kind": "local",
        "command": "ryu-monitors",
        "command_env": "RYU_MONITORS_BIN",
        "port_env": "RYU_MONITORS_PORT"
      },
      "port": 8003,
      "health_path": "/health",
      "http": {
        "mount": "/api/monitors",
        "public_mount": "/api/monitors",
        "routes": [
          { "path": "/alerts/stream" },
          { "path": "/alerts" },
          { "path": "/alerts/:id/ack" },
          { "path": "/" },
          { "path": "/:id" },
          { "path": "/:id/run" },
          { "path": "/:id/snapshots" },
          { "path": "/:id/alerts" }
        ]
      },
      "host_api": {
        "grants": ["tools.invoke"]
      }
    }
  ],
  "permission_grants": ["monitors:crud", "tools.invoke"],
  "permission_levels": [
    {
      "id": "monitors.view",
      "label": "Can view",
      "description": "See configured website monitors and their check history."
    },
    {
      "id": "monitors.edit",
      "label": "Can edit",
      "description": "Create, change, and delete monitors, which decides what this node fetches on a schedule and who gets notified.",
      "implies": ["monitors.view"]
    }
  ],
  "companion": {
    "label": "Monitors",
    "icon": "radar-01"
  },
  "contributes": {
    "data_categories": [
      {
        "id": "monitors",
        "title": "Delete all monitors",
        "noun": "monitors",
        "confirm_word": "Monitors",
        "detail": "Every website monitor will be deleted and its scheduled checks will stop."
      }
    ],
    "quotas": [
      {
        "id": "maxMonitors",
        "label": "Website monitors",
        "unit": "count"
      }
    ],
    "hook_events": [
      {
        "id": "@ryu/monitors#alert.raised",
        "title": "Monitor alert raised",
        "description": "A scheduled (or run-now) check tripped its alert condition and the alert was stored. Fires once per transition, not once per check: a site that stays down, or a keyword that stays present, does not re-raise. `kind` says which transition it was — `uptime_down` / `uptime_up` / `keyword` / `content_change` / `price` / `stock` — so a recovery is this same event with `kind: \"uptime_up\"`.",
        "payload_example": {
          "alert_id": 42,
          "monitor_id": "mon_9f2c1b7a4e5d4f0a8c3b6d1e7f905a2c",
          "monitor_name": "Concert tickets",
          "url": "https://example.com/tickets",
          "kind": "stock",
          "title": "Now in stock",
          "message": "On HTTP 200",
          "value": "in_stock",
          "created_at": "2026-08-01T10:15:00Z"
        }
      },
      {
        "id": "@ryu/monitors#check.failed",
        "title": "Monitor check failed",
        "description": "A check could not complete — the fetch failed, the crawler was unavailable, or the price/region regex matched nothing — so the site was never actually evaluated. The watch is broken, not the watched page. Unlike an alert this is NOT transition-gated: a monitor that keeps failing emits this on EVERY run until it is fixed. Uptime checks never emit it, because for them a failed fetch is the signal (`uptime_down`) rather than an error.",
        "payload_example": {
          "monitor_id": "mon_9f2c1b7a4e5d4f0a8c3b6d1e7f905a2c",
          "monitor_name": "Laptop price",
          "url": "https://example.com/laptop",
          "reason": "price regex '\\$([0-9.,]+)' did not match",
          "checked_at": "2026-08-01T10:15:00Z"
        }
      }
    ],
    "views": [
      {
        "id": "surface:monitors",
        "title": "Monitors",
        "view": "list-detail",
        "spec": {
          "view": "list-detail",
          "items": [],
          "emptyText": "No monitors yet.",
          "source": {
            "http": { "method": "GET", "path": "/api/monitors" },
            "items": "monitors",
            "map": {
              "title": "name",
              "subtitle": "url",
              "accessory": "last_status"
            }
          },
          "itemActions": [
            {
              "id": "run",
              "label": "Check now",
              "style": "primary",
              "http": {
                "method": "POST",
                "path": "/api/monitors/{{item.id}}/run"
              }
            }
          ]
        }
      }
    ]
  }
}
